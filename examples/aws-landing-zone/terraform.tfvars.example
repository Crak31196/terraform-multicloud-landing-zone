# Copy to terraform.tfvars and fill in with your own values.
# Every value below is a placeholder -- no real account IDs, ARNs or emails.

aws_region  = "us-east-1"
name_prefix = "acme"
environment = "dev"

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
single_nat_gateway   = true

# Replace with the ARNs of IAM users/roles that should be able to assume the
# break-glass admin role and administer the KMS key. Use placeholder account ID
# 123456789012 only as an example -- substitute your real account ID.
break_glass_principal_arns = [
  "arn:aws:iam::123456789012:user/example-admin"
]

key_administrators = [
  "arn:aws:iam::123456789012:user/example-admin"
]

monthly_budget_limit_usd = 500

budget_notification_emails = [
  "alerts@example.com"
]

tags = {
  Owner = "platform-team"
}
