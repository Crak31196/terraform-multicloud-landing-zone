# Example environment file for any convenience wrapper scripts in this repo
# (e.g. a Makefile/shell script that shells out to `terraform` per cloud/environment).
#
# Every value below is a placeholder. Real cloud credentials NEVER belong in this file
# or in any .env file committed to version control -- authenticate via your cloud
# provider's own CLI/SSO instead:
#   AWS:   aws sso login / aws configure   (or an assumed role / OIDC in CI)
#   Azure: az login                        (or a service principal / OIDC in CI)

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=example-profile

# --- Azure ---
ARM_LOCATION=eastus
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# --- General ---
TF_VAR_name_prefix=acme
TF_VAR_environment=dev
